# 依赖
node_modules/

# 运行时产物（每次运行重新生成，不入库）
daily_reports/
# 站点发布根（2026-09-14 B-3）：由 publishReport 写当期页、build-site 汇集并生成
# index/archive/.nojekyll/og-image；CI 以它为 Pages artifact，属构建产物不入库。
site/
# 归一化全量池导出（gzinfo data/fetched-articles.json 同位；运行时产物不入库）
data/fetched-articles.json

# LLM 调用埋点（logs/llm-calls.jsonl，quota-report 数据源；本机/每次运行累积，不入库）
logs/
data/history/
data/cache/
data/local-acquired.json
# 注意：根 history/ **必须入库**——CI 每日「Archive reports to history/」把报告归档到
# main 的 history/<date>/（含 store.json），供 SKIP_AI 复用与历史追溯；与 gzinfo 口径一致
# （gzinfo 忽略 /data/history/ 但提交根 /history/）。此处只忽略 data/history/，勿改回 history/。
# 注意：data/local-ipo.json **必须入库**——本地 ipo:local 产出后提交推送，
# 远端 CI 读取补数（本地/远端唯一衔接文件），见 lib/adapters/local-ipo.ts
# 红筹监测运行时产物（每次运行重新抓取生成；**data/redchip/leads.json 是人工冻结快照，
# 必须入库**，故只忽略下列三条、勿整目录忽略——见 docs/plan-redchip-crawl-push.md §6）
data/redchip/latest.json
data/redchip/snapshots/
data/redchip/changelog.jsonl
*.log

# WorkBuddy 工作区数据（项目代码仓库不携带）
.workbuddy/

# 环境变量 / 密钥
.env
.env.local

# 构建产物
dist/
*.tsbuildinfo

# OS / 编辑器
.DS_Store
.idea/
.vscode/

# 测试覆盖率
coverage/

# 构建期中间产物（检索索引；由 npm run build:index 生成，build-site 搬进 site/data）
build/
