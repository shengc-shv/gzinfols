# —— 报告全局参数 ——
# 报告时区（影响「今日」判定与日期窗口）
REPORT_TZ=Asia/Shanghai
# 报告语言：zh | en
REPORT_LOCALE=zh

# —— LLM 后端 ——
# 可选：claude-cli | anthropic | openai | deepseek | minimax（CI 用 deepseek）
LLM_BACKEND=claude-cli
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek 可选覆盖（缺省 https://api.deepseek.com/v1 / deepseek-chat）
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# —— 发布（自有仓库 gzinfols）——
# 用于推送到 gzinfols 自己的 gh-pages
GITHUB_TOKEN=
GITHUB_REPO=shengc-shv/gzinfols

# —— 抓取 / 窗口参数 ——
# 单源抓取条数上限
PER_SOURCE_FETCH_CAP=10
# 采集窗口（天）：仅取该窗口内发布的条目
FETCH_WINDOW_DAYS=2
# 展示窗口（天）：超过该窗口的归入「过去 N 天」tab
DISPLAY_WINDOW_DAYS=2

# —— 语音播报（可选）——
AUDIO_ENABLED=false
