# —— 报告全局参数 ——
# 报告时区（影响「今日」判定与日期窗口）
# 时区：全项目固定 Asia/Shanghai（北京时间），不支持配置（硬性规定）
# REPORT_TZ=Asia/Shanghai
# 报告语言：zh | en
REPORT_LOCALE=zh

# —— LLM 后端 ——
# 可选：claude-cli | anthropic | openai | deepseek（CI 用 deepseek）
LLM_BACKEND=claude-cli
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek 可选覆盖（缺省 https://api.deepseek.com/v1 / deepseek-chat）
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# —— 发布（自有仓库 gzinfols）——
# 用于推送到 gzinfols 自己的 gh-pages
GITHUB_TOKEN=
GITHUB_REPO=shengc-shv/gzinfols

# —— 抓取 / 窗口参数 ——
# 单源抓取条数上限
PER_SOURCE_FETCH_CAP=10
# 采集窗口（天）：仅取该窗口内发布的条目
FETCH_WINDOW_DAYS=2
# 展示窗口（天）：超过该窗口的归入「过去 N 天」tab
DISPLAY_WINDOW_DAYS=2

# —— 语音播报（腾讯云 / 阿里云百炼 CosyVoice / Piper 本地兜底；口径对齐 gzinfo）——
# 设为 true 才装配 TTS（CI 的 Generate 步骤会显式注入 true）
AUDIO_ENABLED=false
# 后端候选链（逗号分隔，**显式**：链上没有的后端绝不会被使用）。
#   缺省 cosyvoice,tencent,piper（百炼优先 → 腾讯兜底 → Piper 最后一道）
#   只测百炼写 cosyvoice；要回到旧行为写 tencent,piper
TTS_BACKEND=
# 腾讯云语音合成密钥（Secrets：TENCENTCLOUD_SECRET_ID / TENCENTCLOUD_SECRET_KEY）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 区域（默认 ap-guangzhou）/ 音色（默认 101011）/ 语速（默认 1.2）
TENCENTCLOUD_REGION=ap-guangzhou
TTS_VOICE_TYPE=101011
TTS_SPEED=1.2
# 腾讯云发音策略：ssml-say-as（默认，AUM 等缩写逐字母读，2026-09-10 试听定案）| translit | none
TTS_PRONOUNCE=ssml-say-as

# —— 阿里云百炼 CosyVoice（2026-09-21 接入；**仅北京地域**，Key 与新加坡不通用）——
# 控制台「百炼 → API-KEY 管理」创建；无此 Key 时 cosyvoice 后端被自动跳过
DASHSCOPE_API_KEY=
# **模型链**（逗号分隔，按序尝试）：前一个失败就换下一个；全失败才轮到腾讯 TTS 兜底。
#   缺省：cosyvoice-v3.5-plus（表现力最好）→ cosyvoice-v3.5-flash（更便宜、额度池独立）
#   每项可写 `模型` 或 `模型@音色ID` —— 逐模型指定音色是**必要的**：
#   声音复刻/设计音色在创建时**绑定目标模型**，两个模型往往需要不同的音色 ID。
#   实例（v3.5 两个「声音设计」音色各绑各的模型）：
#   DASHSCOPE_TTS_MODELS=cosyvoice-v3.5-plus@cosyvoice-v3.5-plus-vd-bailian-xxxxxxxx,cosyvoice-v3.5-flash@cosyvoice-v3.5-flash-vd-bailian-yyyyyyyy
DASHSCOPE_TTS_MODELS=cosyvoice-v3.5-plus,cosyvoice-v3.5-flash
# 音色：模型链里没写 @音色 时统一用这个
# ⚠️ v3.5 系列**没有系统音色**（仅支持声音复刻/声音设计）→ 必须填百炼控制台返回的音色 ID。
#    留空的话两个 v3.5 模型都会被跳过（日志打 warning），音频直接降到腾讯。
#    若想用系统音色，把模型链改成 cosyvoice-v3-flash，此时留空由代码用 longanyang 兜底。
DASHSCOPE_TTS_VOICE=
# 置 true 跳过「模型 × 音色」兼容性判定（仅在确知无碍时使用）
DASHSCOPE_TTS_VOICE_FORCE=false
# 端点覆盖：留空用通用域名 dashscope.aliyuncs.com；填 Workspace ID 则走官方专属域名
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/...
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_TTS_ENDPOINT=
# 音频格式（默认 mp3；可选 mp3/pcm/wav/opus，非 mp3 会 ffmpeg 归一）/ 采样率（默认 24000）
DASHSCOPE_TTS_FORMAT=mp3
DASHSCOPE_TTS_SAMPLE_RATE=24000
# 语速 0.5~2.0（默认 1.0）/ 单片字符上限（默认 1900，官方未公开 text 上限故取保守值）
DASHSCOPE_TTS_RATE=1
DASHSCOPE_TTS_CHUNK_LIMIT=1900
# AIGC 隐式水印（默认 false；仅 v3-flash / v3-plus / v2 支持）
DASHSCOPE_TTS_AIGC_TAG=false
# 百炼发音策略：translit（默认，AUM→「诶优艾姆」）| punct | interpunct | plain | asis
#   刻意不用 ssml-say-as：那是腾讯云 SSML 方言，百炼不认
TTS_PRONOUNCE_COSYVOICE=translit

# 调试：设为 true 跳过实际合成（仅拼口播稿）
SKIP_TTS=
# 依赖本机 ffmpeg（分片重编码拼接）；Piper 兜底为可选本地能力（CI 不预装）

